[
  {
    "id": "chatgpt",
    "name": "ChatGPT",
    "origin": "https://chatgpt.com/",
    "input": {
      "selectors": [
        "textarea#prompt-textarea",
        "textarea[id*='composer-prompt']",
        "textarea.wm-composer-textarea",
        "div#prompt-textarea",
        "div[contenteditable='true']",
        "textarea"
      ]
    },
    "send": {
      "type": "button",
      "selectors": [
        "button[aria-label='Send message']",
        "button.wm-compose",
        "button[data-testid='send-button']",
        "button[data-testid='composer-submit-button']"
      ]
    },
    "probe": {
      "loggedOut": [],
      "loginModal": [
        "xpath://*[contains(@class,'modal') and contains(text(),'Log in')]",
        "xpath://*[contains(@class,'modal') and contains(text(),'登录')]"
      ],
      "challenge": [
        "#challenge-stage",
        "iframe[title*='challenge' i]",
        "xpath://*[contains(text(),'Verify you are human')]",
        "xpath://*[contains(text(),'确认您是人类')]"
      ]
    },
    "international": true,
    "verify": {
      "responseIndicator": "ChatGPT said"
    },
    "homeHosts": [
      "chatgpt.com",
      "chat.openai.com",
      "auth.openai.com"
    ],
    "attachment": {
      "selectors": [
        "input.wm-composer-srOnly"
      ]
    }
  },
  {
    "id": "deepseek",
    "name": "DeepSeek",
    "origin": "https://chat.deepseek.com/",
    "input": {
      "selectors": [
        "textarea#chat-input",
        "#chat-input",
        "textarea[placeholder*='消息']",
        "textarea[placeholder*='Message']",
        "textarea"
      ]
    },
    "send": {
      "type": "enter"
    },
    "probe": {
      "loggedOut": [
        "xpath://*[contains(text(),'Login with password')]",
        "xpath://*[contains(text(),'Scan with Wechat to login')]",
        "xpath://div[contains(@class,'ds-button') and contains(text(),'Log in')]",
        "a[href*='/sign_in']",
        "a[href*='/login']"
      ],
      "challenge": [
        "#challenge-stage",
        "#challenge-running",
        "iframe[title*='challenge' i]",
        "iframe[title*='验证' i]"
      ]
    },
    "international": false,
    "homeHosts": [
      "chat.deepseek.com"
    ],
    "attachment": {
      "selectors": [
        "input[type=file]"
      ]
    }
  },
  {
    "id": "kimi",
    "name": "Kimi",
    "origin": "https://www.kimi.com/",
    "input": {
      "selectors": [
        "div.chat-input-editor[contenteditable='true']",
        ".chat-input-editor [contenteditable='true']",
        ".chat-input-editor textarea",
        "[contenteditable='true']",
        "textarea"
      ]
    },
    "send": {
      "type": "button",
      "selectors": [
        "div.send-button-container",
        ".send-button-container",
        "button[aria-label*='发送']",
        "button[aria-label*='Send']"
      ]
    },
    "probe": {
      "loggedOut": [
        "xpath://span[contains(@class,'user-name') and contains(text(),'Log in')]",
        "xpath://*[contains(text(),'Phone number login')]"
      ],
      "loginModal": [
        "xpath://*[contains(@class,'login') and contains(@class,'modal')]",
        "xpath://*[contains(@class,'ant-modal') and contains(text(),'Log in')]"
      ],
      "challenge": [
        "#challenge-stage",
        "iframe[title*='challenge' i]",
        "iframe[title*='验证' i]"
      ]
    },
    "international": false,
    "homeHosts": [
      "www.kimi.com",
      "kimi.moonshot.cn"
    ],
    "attachment": {
      "selectors": [
        "input.hidden-input"
      ],
      "openSelectors": [
        ".toolkit-trigger-btn"
      ]
    }
  },
  {
    "id": "tongyi",
    "name": "通义千问",
    "origin": "https://www.tongyi.com/qianwen/",
    "input": {
      "selectors": [
        "div[contenteditable='true']",
        "[contenteditable='true']",
        "textarea"
      ]
    },
    "send": {
      "type": "pointer",
      "selectors": [
        "button[aria-label='发送消息']"
      ]
    },
    "probe": {
      "loggedOut": [
        "xpath://button[contains(text(),'登录')]",
        "xpath://button[contains(text(),'立即登录')]"
      ],
      "loginModal": [
        "xpath://*[contains(@class,'modal') and contains(text(),'登录')]"
      ],
      "challenge": [
        "iframe[title*='验证' i]",
        "iframe[title*='captcha' i]",
        "#nc_1_n1t"
      ]
    },
    "international": false,
    "prepare": {
      "clickSelector": "xpath://button[contains(.,'新建对话')]",
      "waitSeconds": 3
    },
    "homeHosts": [
      "www.tongyi.com",
      "www.qianwen.com"
    ]
  },
  {
    "id": "yiyan",
    "name": "文心一言",
    "origin": "https://yiyan.baidu.com/",
    "input": {
      "selectors": [
        "textarea#chat-textarea",
        ".ci-textarea",
        "textarea"
      ]
    },
    "send": {
      "type": "enter"
    },
    "probe": {
      "loggedOut": [],
      "loginModal": [
        "xpath://*[contains(@class,'modal') and contains(text(),'登录')]"
      ],
      "challenge": [
        "iframe[title*='验证' i]",
        "xpath://*[contains(text(),'安全验证')]"
      ]
    },
    "international": false,
    "homeHosts": [
      "yiyan.baidu.com",
      "wenxin.baidu.com",
      "passport.baidu.com"
    ]
  }
]